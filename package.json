{
  "name": "hsa-tracker",
  "version": "1.5.0",
  "description": "Local-first HSA eligible expense tracker with AI receipt triage",
  "type": "module",
  "main": "electron.js",
  "author": "plwysong",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dev": "HSA_NO_AUTOEXIT=1 PORT=8322 node --watch server.js",
    "make-launcher": "bash scripts/make-launcher.sh",
    "dist": "electron-builder --mac dir",
    "installer": "bash scripts/make-installer.sh"
  },
  "build": {
    "appId": "local.hsa-tracker",
    "productName": "HSA Tracker",
    "asar": false,
    "files": [
      "**/*",
      "!data/**",
      "!dist/**",
      "!scripts/**",
      "!Setup HSA Tracker.command",
      "!README.md",
      "!src/seed-data.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "artifactName": "HSA Tracker Installer.dmg",
      "title": "HSA Tracker"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/eng": "^1.0.0",
    "archiver": "^7.0.1",
    "express": "^4.21.2",
    "heic-convert": "^2.1.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
